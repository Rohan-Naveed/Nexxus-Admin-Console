<service>
  <id>NexxusAdminConsoleSyncScheduler</id>
  <name>Nexxus Admin Console Sync Scheduler</name>
  <description>Scheduled Google Sheets synchronization for Nexxus Admin Console</description>

  <executable>C:\REPLACE_WITH_NODE_INSTALL_PATH\node.exe</executable>
  <arguments>src\scheduler.js</arguments>
  <workingdirectory>C:\REPLACE_WITH_PROJECT_PATH\backend</workingdirectory>

  <startmode>Automatic</startmode>
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />

  <logpath>C:\REPLACE_WITH_PROJECT_PATH\backend\logs\winsw-scheduler</logpath>
  <log mode="roll" />
</service>
